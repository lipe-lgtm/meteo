[Unit]
Description=Meteo backend (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=meteo
Group=meteo
WorkingDirectory=/opt/meteo
EnvironmentFile=/etc/meteo/meteo.env
# Jeden proces (limit pokusů o přihlášení je v paměti), více vláken stačí
ExecStart=/opt/meteo/venv/bin/gunicorn --workers 1 --threads 4 --bind ${METEO_BIND} --access-logfile - wsgi:app
Restart=on-failure
RestartSec=5

# Zabezpečení: služba smí zapisovat jen do své databáze
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/meteo
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
