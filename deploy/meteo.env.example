# /etc/meteo/meteo.env  (práva 600, vlastník meteo)
# install.sh ho vytvoří sám při první instalaci; ruční úpravy pak už nepřepisuje.

# Kde poslouchá gunicorn (jen localhost)
METEO_BIND=127.0.0.1:8765

# Vygeneruj:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
METEO_SECRET_KEY=ZMEN_ME

METEO_DB=/var/lib/meteo/meteo.db

# Za kolik sekund bez dat je stanice "offline" (stanice posílá každé 2 min)
METEO_OFFLINE_AFTER=600

# Jak dlouho držet historii (dny)
METEO_RETENTION_DAYS=730

# Jak dlouho platí přihlášení v aplikaci (dny)
METEO_SESSION_DAYS=30

# Odkud smí displej (Pico WH) číst starý endpoint /data/simple
METEO_LEGACY_NETS=192.168.1.0/24

# Poloha domova pro předpověď a radar (install.sh doplní sám)
# METEO_LAT=50.0875
# METEO_LON=14.4214
